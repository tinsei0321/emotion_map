{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emc.local/acp/v1/toolcall.schema.json",
  "$comment": "ACP v1 状态对象（契约 §三·最小字段）·壳阶段 S6 校验器权威文件。版本注记位：v1.1（S2 未定稿）载荷结构模式（caliber 摘要收紧为必带 scale/refs）·按 tests/acp_schema/README.md 版本登记表补。",
  "title": "ACP toolcall · 工具调用状态对象（begin|end|error）",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "turn_id", "verb", "status"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "turn_id": {"type": "string", "minLength": 1},
    "verb": {"type": "string", "minLength": 1, "description": "MCP 工具名（工具面归 MCP 不归 ACP）"},
    "status": {"type": "string", "enum": ["begin", "end", "error"]},
    "caliber": {
      "type": "object",
      "additionalProperties": true,
      "required": ["refs"],
      "properties": {
        "scale": {"type": "string"},
        "refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
